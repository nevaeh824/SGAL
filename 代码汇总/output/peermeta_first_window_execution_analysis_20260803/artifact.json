      "query": {
        "engine": "SQLite 3 over reviewed file snapshot",
        "sql": "SELECT total_wall_seconds / 3600.0 AS wall_hours, accuracy, macro_f1, weighted_f1, total_model_fit_count AS fit_total, train_rows, test_rows FROM benchmark_summary;",
        "description": "Selects the successful-run headline metrics after loading benchmark_summary.json as a one-row table.",
